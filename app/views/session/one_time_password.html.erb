<%if @error%>
  <div class='alert alert-error'>
    <%= @error %>
  </div>
<%else%>
  <div class="otp-confirmation">
    <div class="otp-confirmation__spinner-wrap" id="otp-confirmation-spinner">
      <div class="spinner"></div>
      <p><%= t("user_api_key.otp_confirmation.finishing_sign_in") %></p>
    </div>

    <div class="otp-confirmation__fallback" id="otp-confirmation-fallback">
      <h2><%= t("user_api_key.otp_confirmation.confirm_title", site_name: SiteSetting.title) %></h2>
      <p><%= t("user_api_key.otp_confirmation.logging_in_as", username: @otp_username) %></p>
      <p class="otp-confirmation__hint"><%= t("user_api_key.otp_confirmation.taking_longer") %></p>
      <%= form_tag do%>
        <%= submit_tag(t("user_api_key.otp_confirmation.confirm_button"), class: "btn btn-primary") %>
      <%end%>
    </div>

    <div class="otp-confirmation__stuck" id="otp-confirmation-stuck">
      <p class="otp-confirmation__hint"><%= t("user_api_key.otp_confirmation.still_stuck") %></p>
      <a href="#" id="otp-confirmation-reload" class="btn btn-default"><%= t("user_api_key.otp_confirmation.reload_button") %></a>
    </div>
  </div>

  <script>
    (function () {
      var submitted = false;

      // Single guarded path for submitting the form. The mobile app's
      // injected auto-submit JS calls this (falling back to a raw
      // form.submit() only if it loaded before this script ran) instead of
      // calling form.submit() directly, so an auto-submit racing a manual
      // fallback tap can't double-POST the same one-time token — a second
      // POST after the first has already been processed gets told the
      // token is invalid, even though the first one succeeded. This guard
      // is what prevents that false error.
      window.__otpAutoSubmit = function () {
        if (submitted) { return; }
        submitted = true;
        var form = document.querySelector("form");
        if (form) { form.submit(); }
      };

      document.addEventListener("DOMContentLoaded", function () {
        var form = document.querySelector("form");
        if (form) {
          form.addEventListener("submit", function (e) {
            if (submitted) {
              e.preventDefault();
              return;
            }
            submitted = true;
          });
        }

        var reload = document.getElementById("otp-confirmation-reload");
        if (reload) {
          reload.addEventListener("click", function (e) {
            e.preventDefault();
            window.location.reload();
          });
        }
      });

      // Sign-in normally auto-submits within ~1s. Only reveal the manual
      // fallback button if nothing has submitted yet after a few seconds —
      // if a submit is already in flight (just slow, not stuck), skip this
      // so the user can't race it with a second one.
      window.setTimeout(function () {
        if (submitted) { return; }
        var spinner = document.getElementById("otp-confirmation-spinner");
        var fallback = document.getElementById("otp-confirmation-fallback");
        if (spinner) { spinner.style.display = "none"; }
        if (fallback) { fallback.classList.add("-visible"); }
      }, 2500);

      // Last-resort escape hatch for a genuinely hung request (server-side
      // stall, not a network failure — those already surface the app's own
      // WebView error/retry screen). Reload re-checks the token
      // server-side, but unlike a fresh GET, it can *abort* a POST that's
      // still in flight — and the controller's login (session cookie) and
      // token deletion both complete server-side as soon as the request is
      // processed, regardless of whether the client is still around to
      // receive the response. So reloading right as a slow-but-succeeding
      // submit is about to finish can delete the token and lose the
      // not-yet-delivered cookie, turning a working login into a false
      // "invalid token" error. Only offer this immediately (9s) when
      // nothing has actually been submitted yet — reload is fully safe
      // then, since there's nothing in flight to abort. If a submit did
      // happen, wait much longer (19s total) before offering it, by which
      // point the request has either already resolved (this page is gone)
      // or is genuinely hung rather than merely slow.
      function revealStuck() {
        var stuck = document.getElementById("otp-confirmation-stuck");
        if (stuck) { stuck.classList.add("-visible"); }
      }

      window.setTimeout(function () {
        if (!submitted) { revealStuck(); }
      }, 9000);

      window.setTimeout(revealStuck, 19000);
    })();
  </script>
<%end%>
